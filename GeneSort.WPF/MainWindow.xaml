<Window x:Class="GeneSort.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GeneSort.WPF.Views"
        xmlns:vm="clr-namespace:GeneSort.WPF.ViewModels"
        Title="GeneSort" Height="720" Width="1120"
        MinHeight="480" MinWidth="760" Background="#F3F5F8">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MessagePackBrowserViewModel}">
            <views:MessagePackBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SandboxViewModel}">
            <views:SandboxView />
        </DataTemplate>
    </Window.Resources>
    <TabControl Margin="12">
        <TabItem Header="MessagePack Browser" Content="{Binding MessagePackBrowser}" />
        <TabItem Header="Sandbox" Content="{Binding Sandbox}" />
    </TabControl>
</Window>
