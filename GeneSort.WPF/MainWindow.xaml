<Window x:Class="GeneSort.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GeneSort.WPF.Views"
        xmlns:vm="clr-namespace:GeneSort.WPF.ViewModels"
        Style="{StaticResource {x:Type Window}}" Title="GeneSort" Height="720" Width="1120"
        MinHeight="480" MinWidth="760" Background="{DynamicResource CanvasBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MessagePackBrowserViewModel}">
            <views:MessagePackBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SandboxViewModel}">
            <views:SandboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunEditorViewModel}">
            <views:RunEditorView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="16" Background="{DynamicResource CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
            <TextBlock Text="GeneSort" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Experiment workspace" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TabControl>
            <TabItem Header="MessagePack Browser" Content="{Binding MessagePackBrowser}" />
            <TabItem Header="Run Editor" Content="{Binding RunEditor}" />
            <TabItem Header="Sandbox" Content="{Binding Sandbox}" />
        </TabControl>
    </DockPanel>
</Window>
