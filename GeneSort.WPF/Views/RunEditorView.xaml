<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="GeneSort.WPF.Views.RunEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeneSort.WPF.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <Style x:Key="SelectableMessage" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <DataTemplate x:Key="IntervalTemplate">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Row="1" Background="#193750" BorderBrush="#62B7F3" BorderThickness="0,2,0,0" Padding="16,10"
                Visibility="{Binding IsPhaseRunning, Converter={StaticResource VisibleIfTrue}}">
            <DockPanel>
                <Button Content="Cancel" FontWeight="Bold" MinWidth="100" Padding="12,8" AutomationProperties.Name="Cancel active phase" Click="CancelPhase_Click" IsEnabled="{Binding CanCancelPhase}" DockPanel.Dock="Left"
                        ToolTip="Stop queued rows and request active work to stop at its next safe point." />
                <StackPanel>
                    <TextBlock Text="{Binding PhaseActivity}" FontWeight="Bold" FontSize="16" AutomationProperties.Name="Active phase status" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,6,0,6" AutomationProperties.Name="Active phase activity" />
                    <TextBlock Text="{Binding PhaseSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    <local:RunSelectionView x:Name="RunSelection" DataContext="{Binding Selection}"
                            Visibility="{Binding DataContext.IsSelectingRun, RelativeSource={RelativeSource AncestorType=local:RunEditorView}, Converter={StaticResource VisibleIfTrue}}" />
    <Button Content="Return to editor" Click="ReturnToEditor_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
            Visibility="{Binding CanReturnToEditor, Converter={StaticResource VisibleIfTrue}}" />
    <Grid Margin="16" Visibility="{Binding IsEditingRun, Converter={StaticResource VisibleIfTrue}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsReady}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Back" Click="ChooseRun_Click" ToolTip="Back to this run module. Your editor changes are kept." />
                <Button Content="Clone" Click="Clone_Click" IsEnabled="{Binding CanClone}" ToolTip="Clone the opened definition in the same module. Parameter files and results are not copied." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Run editor" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DirtyLabel}" Foreground="{DynamicResource WarningBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding DirtyLabel}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Padding="12,10" IsEnabled="{Binding IsReady}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Padding" Value="6,3" />
                        </Style>
                    </StackPanel.Resources>
                <TextBlock Text="{Binding SourceDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding SourceDescription}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Project name" /><TextBox IsReadOnly="{Binding ModulePropertiesLocked}" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Database name" /><TextBox IsReadOnly="{Binding ModulePropertiesLocked}" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Database name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Run name" /><TextBox IsReadOnly="{Binding DefinitionReadOnly}" Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Run name" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Description" />
                        <TextBox IsReadOnly="{Binding ModulePropertiesLocked}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsEnabled="{Binding CanEditModuleProperties}" Content="Allow output overwrite" ToolTip="Allow workflow output overwrite" IsChecked="{Binding AllowOverwrite}" Margin="16,18,0,0" VerticalAlignment="Center" />
                </Grid>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Projects folder" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" />
                    <TextBox Text="{Binding ProjectsFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Projects folder" />
                </DockPanel>
                <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="10,0,0,0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Configure &amp; run" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Set parameters, generate files, then process and review results." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                <WrapPanel Margin="0,0,0,12">
                    <TextBlock Text="Parallel threads" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding ParallelThreads, UpdateSourceTrigger=PropertyChanged}" Width="70"
                             IsEnabled="{Binding IsReady}" AutomationProperties.Name="Parallel threads"
                             ToolTip="Maximum selected rows running concurrently during Setup or Processing." />
                    <TextBlock Text="{Binding ParallelThreadsError}" Foreground="Orange" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>
                <TabControl AutomationProperties.Name="Run configuration, processing and results">
                    <TabItem Header="Parameters">
                        <StackPanel Margin="12" IsEnabled="{Binding CanEditDefinition}">
                            <StackPanel Visibility="{Binding HasSgdSourceSelection, Converter={StaticResource VisibleIfTrue}}" Margin="0,0,0,12">
                                <TextBlock Text="Setup source modules" FontWeight="SemiBold" />
                                <TextBlock Text="SortableTests module" />
                                <TextBox IsReadOnly="{Binding ModulePropertiesLocked}" Text="{Binding SortableTestsModule, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SortableTests source module" />
                                <TextBlock Text="SorterEval module" Margin="0,6,0,0" />
                                <TextBox IsReadOnly="{Binding ModulePropertiesLocked}" Text="{Binding SorterEvalModule, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SorterEval source module" />
                            </StackPanel>
                            <TextBlock Text="{Binding DefinitionEditHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" Visibility="{Binding ModulePropertiesLocked, Converter={StaticResource VisibleIfTrue}}" />
                            <TextBlock Text="Use + value for a parameter sweep. Multiple values create combinations within each phase." TextWrapping="Wrap" />
                            <local:ParameterSectionView DataContext="{Binding SetupSection}" Visibility="{Binding DataContext.HasSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIfTrue}}" />
                            <local:ParameterSectionView DataContext="{Binding ExecutionSection}" />
                            <Expander Header="Parameter reference" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Save intervals" Visibility="{Binding IsEvolution, Converter={StaticResource VisibleIfTrue}}">
                        <StackPanel Margin="12" IsEnabled="{Binding IsReady}">
                            <TextBlock Text="Checkpoint schedule" />
                            <ComboBox ItemsSource="{Binding Intervals}" ItemTemplate="{StaticResource IntervalTemplate}" SelectedValuePath="Name" SelectedValue="{Binding CheckpointIntervals}" IsEnabled="{Binding CanEditModuleProperties}" AutomationProperties.Name="Checkpoint schedule" />
                            <TextBlock Text="Keep the latest valid recovery checkpoint for each processing row. Older checkpoints are removed after a successful save." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="Snapshot schedule" />
                            <ComboBox ItemsSource="{Binding Intervals}" ItemTemplate="{StaticResource IntervalTemplate}" SelectedValuePath="Name" SelectedValue="{Binding SaveIntervals}" IsEnabled="{Binding CanEditModuleProperties}" AutomationProperties.Name="Snapshot schedule" />
                            <TextBlock Text="Keep all snapshots for timeline analysis. GenerationIntervalLast selects a zero-based index in this snapshot schedule." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" />
                            <TextBlock Text="Summary sampling schedule" />
                            <ComboBox ItemsSource="{Binding Intervals}" ItemTemplate="{StaticResource IntervalTemplate}" SelectedValuePath="Name" SelectedValue="{Binding SummaryIntervals}" IsEnabled="{Binding CanEditModuleProperties}" AutomationProperties.Name="Summary sampling schedule" />
                            <TextBlock Text="This is a run setting. Replacing a saved run definition asks for confirmation separately." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Catalog selections">
                        <StackPanel Margin="12">
                            <TextBlock Text="This workflow supplies a compatible group of catalog entries." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Catalogs}">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Generate parameters">
                        <StackPanel Margin="12" IsEnabled="{Binding IsReady}">
                            <TextBlock Text="Generate RunParameters" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding PhaseHelp}"
                                       TextWrapping="Wrap" Margin="0,6,0,14" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,20,12">
                                    <TextBlock Text="First replica" />
                                    <TextBox Text="{Binding FirstReplica, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                             HorizontalAlignment="Left" AutomationProperties.Name="First replica" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Replica count" />
                                    <TextBox Text="{Binding ReplicaCount, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                             HorizontalAlignment="Left" AutomationProperties.Name="Replica count" />
                                </StackPanel>
                            </WrapPanel>
                            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <TextBlock Text="{Binding GenerationPreview}" TextWrapping="Wrap" AutomationProperties.Name="Generation preview" />
                            </Border>
                            <TextBlock Text="Generating publishes the complete parameter set for this run. Replacing existing files requires confirmation."
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Validate" Click="Validate_Click" />
                                <Button Content="Generate RunParameters" Click="Generate_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanGenerateParameters}"
                                        HorizontalAlignment="Left" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="SetupParametersTab" Header="Setup parameters" Visibility="{Binding HasSetup, Converter={StaticResource VisibleIfTrue}}">
                        <StackPanel Margin="12">
                            <TextBlock Text="Each row represents shared Setup inputs. Selecting it prepares the inputs and updates all linked run rows."
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Refresh saved files" Click="RefreshParameters_Click" IsEnabled="{Binding CanLoadRunParameters}" />
                                <Button Content="Run Setup" Click="RunSetup_Click" IsEnabled="{Binding CanRunSetup}" FontWeight="SemiBold"
                                        ToolTip="Prepare the selected shared inputs for every linked run. Save definition changes first." ToolTipService.ShowOnDisabled="True" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SetupParameterList.SelectionSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PhaseSummary, Mode=OneWay}" Style="{StaticResource SelectableMessage}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Setup phase progress" />
                            <local:SetupParameterListView DataContext="{Binding SetupParameterList}" Height="360" />
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="RunParametersTab" Header="Processing parameters">
                        <StackPanel Margin="12">
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Refresh saved files" Click="RefreshParameters_Click" IsEnabled="{Binding CanLoadRunParameters}" />
                                <Button Content="Run Processing" Click="RunExecution_Click" IsEnabled="{Binding CanRunExecution}" FontWeight="SemiBold"
                                        ToolTip="Process the selected saved rows using prepared inputs. Resumes saved checkpoints and skips finished runs." ToolTipService.ShowOnDisabled="True" />
                                <Button Content="Generate Summary Reports" Click="GenerateSummaryReports_Click" IsEnabled="{Binding CanGenerateSummaryReports}" FontWeight="SemiBold"
                                        ToolTip="Generate Summary Reports from saved results for the selected rows, including finished runs. Uses the run's output overwrite setting." ToolTipService.ShowOnDisabled="True" />
                            </WrapPanel>
                            <TextBlock Text="{Binding RunParameterList.SelectionSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBox Text="{Binding PhaseSummary, Mode=OneWay}" Style="{StaticResource SelectableMessage}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Run phase progress" />
                            <local:RunParameterListView DataContext="{Binding RunParameterList}" Height="360" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Summary Reports" Visibility="{Binding IsEvolution, Converter={StaticResource VisibleIfTrue}}">
                        <StackPanel Margin="12">
                            <TextBlock Text="Select rows in Processing parameters to view their saved Summary Reports here." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Refresh reports" Click="RefreshReports_Click" IsEnabled="{Binding CanRefreshSummaryReports}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,8" AutomationProperties.Name="Loading Summary Reports"
                                         Visibility="{Binding SummaryReportList.IsLoading, Converter={StaticResource VisibleIfTrue}}" />
                            <local:SummaryReportListView DataContext="{Binding SummaryReportList}" Height="400" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
                </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}" Maximum="{Binding PhaseTotal, Mode=OneWay}" Value="{Binding PhaseCompleted, Mode=OneWay}"
                         AutomationProperties.Name="Operation progress" Height="6" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIfTrue}}" />
            <DockPanel Visibility="{Binding HasErrors, Converter={StaticResource VisibleIfTrue}}">
                <Button DockPanel.Dock="Right" Content="Copy errors" Click="CopyErrors_Click" VerticalAlignment="Top" Margin="8,0,0,0"
                        ToolTip="Copy all error messages, including full file paths." AutomationProperties.Name="Copy errors" />
                <TextBox Text="{Binding ErrorMessages, Mode=OneWay}" Style="{StaticResource SelectableMessage}"
                         Foreground="{DynamicResource ErrorBrush}" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Run errors" />
            </DockPanel>
            <TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource SelectableMessage}" Margin="0,4,0,0"
                     MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Run status" />
        </StackPanel>
    </Grid>
    </Grid>
</UserControl>
