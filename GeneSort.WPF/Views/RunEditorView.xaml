<UserControl x:Class="GeneSort.WPF.Views.RunEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,4" />
        </Style>
        <DataTemplate x:Key="IntervalTemplate">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16" IsEnabled="{Binding IsReady}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New" Click="New_Click" />
                <Button Content="Open…" Click="Open_Click" />
                <Button Content="Validate" Click="Validate_Click" />
                <Button Content="Save" Click="Save_Click" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Run editor" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DirtyLabel}" Foreground="#965B12" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding WorkflowName}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WorkflowDescription}" Foreground="#536075" Margin="0,3,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Project name" /><TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project name" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Database name" /><TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Database name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Run name" /><TextBox Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Run name" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Description" Margin="0,10,0,0" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
                <TextBlock Text="Projects folder" Margin="0,10,0,0" />
                <DockPanel>
                    <Button Content="Browse…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" />
                    <TextBox Text="{Binding ProjectsFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Projects folder" />
                </DockPanel>
                <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" Foreground="#536075" FontSize="11" Margin="0,4,0,12" />
                <TabControl>
                    <TabItem Header="Parameters">
                        <StackPanel Margin="12">
                            <TextBlock Text="Enter comma-separated values. Multiple values create combinations within each phase." TextWrapping="Wrap" />
                            <TextBlock Text="Setup parameters" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <DataGrid x:Name="SetupGrid" ItemsSource="{Binding SetupParameters}" AutoGenerateColumns="False" CanUserAddRows="False" Height="205" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Parameter" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SetupKeys, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Values" Width="3*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Values, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add parameter" Click="AddSetup_Click" /><Button Content="Remove selected" Click="RemoveSetup_Click" />
                            </StackPanel>
                            <TextBlock Text="Execution overrides" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <TextBlock Text="Setup values are inherited. Pool sizes are defined in setup." Foreground="#536075" Margin="0,0,0,6" />
                            <DataGrid x:Name="ExecutionGrid" ItemsSource="{Binding ExecutionParameters}" AutoGenerateColumns="False" CanUserAddRows="False" Height="125" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Parameter" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ExecutionKeys, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Values" Width="3*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Values, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add override" Click="AddExecution_Click" /><Button Content="Remove selected" Click="RemoveExecution_Click" />
                            </StackPanel>
                            <Expander Header="Parameter reference" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Save intervals">
                        <StackPanel Margin="12">
                            <TextBlock Text="Generation save schedule" />
                            <ComboBox ItemsSource="{Binding Intervals}" ItemTemplate="{StaticResource IntervalTemplate}" SelectedValuePath="Name" SelectedValue="{Binding SaveIntervals}" AutomationProperties.Name="Generation save schedule" />
                            <TextBlock Text="GenerationIntervalLast selects a zero-based index in this schedule." Foreground="#536075" Margin="0,4,0,12" />
                            <TextBlock Text="Summary sampling schedule" />
                            <ComboBox ItemsSource="{Binding Intervals}" ItemTemplate="{StaticResource IntervalTemplate}" SelectedValuePath="Name" SelectedValue="{Binding SummaryIntervals}" AutomationProperties.Name="Summary sampling schedule" />
                            <CheckBox Content="Allow workflow output overwrite" IsChecked="{Binding AllowOverwrite}" Margin="0,16,0,4" />
                            <TextBlock Text="This is a run setting. Replacing a saved run definition asks for confirmation separately." TextWrapping="Wrap" Foreground="#536075" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Catalog selections">
                        <StackPanel Margin="12">
                            <TextBlock Text="This workflow supplies a compatible group of catalog entries." TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Catalogs}">
                                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#536075" />
                                </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#A32525" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
