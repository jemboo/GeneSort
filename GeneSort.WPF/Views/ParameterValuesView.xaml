<UserControl x:Class="GeneSort.WPF.Views.ParameterValuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parameters="clr-namespace:GeneSort.Project.V1.Parameters;assembly=GeneSort.Project.V1">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate x:Key="NumberEditor">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="54" InputScope="Number"
                     Padding="6,4" BorderThickness="0" VerticalContentAlignment="Center" AutomationProperties.Name="Numeric value" />
        </DataTemplate>
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="170"
                     Padding="6,4" BorderThickness="0" VerticalContentAlignment="Center" AutomationProperties.Name="Text value" />
        </DataTemplate>
        <DataTemplate x:Key="ChoiceEditor">
            <!-- Read-only text also displays unrecognized saved choices so opening never silently replaces them. -->
            <ComboBox ItemsSource="{Binding Choices}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True" IsReadOnly="True" IsTextSearchEnabled="False" Width="90" Padding="5,4"
                      BorderThickness="0" AutomationProperties.Name="Choice value" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="+ value" Click="AddValue_Click" IsEnabled="{Binding CanAddValue}"
                    Padding="8,4" Margin="4,0,0,4" VerticalAlignment="Top" ToolTip="Add another value to this parameter's sweep" />
            <ItemsControl ItemsSource="{Binding Values}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Margin="0,0,6,4" BorderThickness="1" CornerRadius="3" Background="White" ToolTip="{Binding Error}">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#AAB5C4" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="BorderBrush" Value="#B42318" />
                            </DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×" Click="RemoveValue_Click" Padding="5,0" Margin="0"
                                    BorderThickness="0" Background="Transparent" Foreground="#536075" ToolTip="Remove this value"
                                    AutomationProperties.Name="Remove value" />
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style><Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static parameters:parameterValueKind.Integer}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource NumberEditor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static parameters:parameterValueKind.Number}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource NumberEditor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static parameters:parameterValueKind.Choice}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ChoiceEditor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style></ContentControl.Style>
                            </ContentControl>
                        </DockPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
        <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" FontSize="11"
                   Visibility="{Binding HasErrors, Converter={StaticResource VisibleIfTrue}}" />
    </StackPanel>
</UserControl>
