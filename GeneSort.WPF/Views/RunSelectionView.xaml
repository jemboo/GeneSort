<UserControl x:Class="GeneSort.WPF.Views.RunSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource {x:Type UserControl}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Run selection" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,8"
                       Visibility="{Binding IsFolderStep, Converter={StaticResource VisibleIfTrue}}" />
            <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="-4,5,0,8" IsEnabled="{Binding IsReady}"
                          Visibility="{Binding IsHierarchyStep, Converter={StaticResource VisibleIfTrue}}"
                          AutomationProperties.Name="Module path">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="/" FontSize="24" Foreground="{DynamicResource MutedBrush}" Margin="4,2" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Content="{Binding Name}" Click="Breadcrumb_Click" FontSize="24" FontWeight="SemiBold"
                                    Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand"
                                    ToolTip="{Binding ModulePath}" AutomationProperties.Name="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ModuleDescription}" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="{Binding IsHierarchyStep, Converter={StaticResource VisibleIfTrue}}" />
            <TextBlock Text="{Binding Help}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,16,0,12" IsEnabled="{Binding IsReady}"
                   Visibility="{Binding IsHierarchyStep, Converter={StaticResource VisibleIfTrue}}">
            <Button Content="Back" Click="Back_Click" Margin="0,0,8,8" />
            <Button Content="All modules" Click="Home_Click" Margin="0,0,8,8" />
            <Button Content="Change folder" Click="Folder_Click" Margin="0,0,8,8" />
            <Button Content="Refresh runs" Click="Refresh_Click" Margin="0,0,8,8" />
        </WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsReady}">
            <Grid>
                <WrapPanel Visibility="{Binding IsFolderStep, Converter={StaticResource VisibleIfTrue}}" Margin="0,20,0,0">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,12">
                        <StackPanel Width="380">
                            <Path Data="M 2,8 L 2,32 L 42,32 L 42,12 L 20,12 L 15,6 L 2,6 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="44" Height="36" HorizontalAlignment="Left" Margin="0,0,0,16" />
                            <TextBlock Text="Projects folder" FontSize="17" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wizard projects folder" Margin="0,10,0,12" />
                            <WrapPanel>
                                <Button Content="Browse folders…" Click="Browse_Click" Margin="0,0,8,8" />
                                <Button Content="Continue" Click="Continue_Click" IsEnabled="{Binding CanContinue}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Tiles}" Visibility="{Binding IsHierarchyStep, Converter={StaticResource VisibleIfTrue}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="190" MinHeight="178" Margin="0,0,12,12" Padding="14" Click="Tile_Click"
                                    AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding Detail}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModule}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsMaterialized}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Width="156">
                                    <Grid Height="64" Width="76" Margin="0,0,0,12">
                                        <!-- Offset frames suggest a container of definitions, leaving its type image intact. -->
                                        <Grid Visibility="{Binding IsModule, Converter={StaticResource VisibleIfTrue}}">
                                            <Border Margin="18,0,0,14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Opacity="0.35" />
                                            <Border Margin="9,7,9,7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Opacity="0.65" />
                                            <Border Margin="0,14,18,0" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="6" />
                                        </Grid>
                                        <Border Margin="9,7" CornerRadius="25">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModule}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding CreateNew}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMaterialized}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style></Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="28" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModule}" Value="True"><Setter Property="Margin" Value="-18,14,0,0" /><Setter Property="FontSize" Value="26" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMaterialized}" Value="True"><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" Height="5" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}" />
            <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
            <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Run discovery status" />
        </StackPanel>
    </Grid>
</UserControl>
