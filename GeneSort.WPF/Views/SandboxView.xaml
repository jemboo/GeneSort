<UserControl x:Class="GeneSort.WPF.Views.SandboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="18" Padding="24" Background="White" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="#172B43" />
            <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Foreground="#596675" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
