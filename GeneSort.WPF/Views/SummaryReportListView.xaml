<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="GeneSort.WPF.Views.SummaryReportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <WrapPanel Grid.Row="1">
            <Button Content="Save combined report…" Click="SaveCombined_Click" IsEnabled="{Binding CanSaveCombined}"
                    Margin="0,0,8,8" ToolTip="Save all rows using only visible columns, preserving column order and sorting." />
            <Button Content="Columns…" Click="ChooseColumns_Click" Margin="0,0,8,8"
                    ToolTip="Choose which columns to show. Changes are saved immediately." />
            <Button Content="Reset layout" Click="ResetLayout_Click" Margin="0,0,0,8"
                    ToolTip="Show all columns and restore the default column order, widths and sorting for Summary Reports." />
        </WrapPanel>
        <ListView Grid.Row="2" ItemsSource="{Binding Items}" AutomationProperties.Name="Saved Summary Reports"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                <Setter Property="ToolTip" Value="{Binding SourcePath}" />
            </Style></ListView.ItemContainerStyle>
            <ListView.View><GridView x:Name="ReportColumns" AllowsColumnReorder="True" /></ListView.View>
        </ListView>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="LayoutStatus" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Summary Reports layout status" />
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Combined report save status" />
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,2" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
