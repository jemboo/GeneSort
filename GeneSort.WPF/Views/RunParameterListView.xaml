<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="GeneSort.WPF.Views.RunParameterListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ProcessingStatusTemplate">
            <Grid>
                <TextBlock x:Name="StatusText" Text="{Binding Status}" />
                <TextBlock x:Name="FailureLink" Visibility="Collapsed">
                    <Hyperlink Click="FailedStatus_Click" Foreground="{DynamicResource ErrorBrush}"
                               ToolTip="View this run's error message" AutomationProperties.Name="View run failure">Failed</Hyperlink>
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FailureLink" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <WrapPanel Grid.Row="1">
            <Button Content="Columns…" Click="ChooseColumns_Click" Margin="0,0,8,8"
                    ToolTip="Choose which columns to show. Changes are saved immediately." />
            <Button Content="Reset layout" Click="ResetLayout_Click" Margin="0,0,0,8"
                    ToolTip="Show all columns and restore the default column order, widths and sorting for Run parameters." />
            <TextBlock Text="Waiting: gray | Running: blue | Completed: green | Failed: red"
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,8" />
        </WrapPanel>
        <ListView x:Name="ParameterItems" Grid.Row="2" ItemsSource="{Binding Items}"
                  AutomationProperties.Name="Saved RunParameters" SelectionMode="Extended"
                  SelectionChanged="SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Background" Value="#292E36" />
                    <Setter Property="BorderBrush" Value="#8993A3" />
                    <Setter Property="Template"><Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="4,0,0,0" Padding="{TemplateBinding Padding}">
                                <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent">
                                    <GridViewRowPresenter Content="{TemplateBinding Content}"
                                        Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Background" Value="#193750" /><Setter Property="BorderBrush" Value="#62B7F3" /></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Background" Value="#193D33" /><Setter Property="BorderBrush" Value="#65D3A2" /></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#49282C" /><Setter Property="BorderBrush" Value="#F08089" /></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View><GridView x:Name="ParameterColumns" AllowsColumnReorder="True" /></ListView.View>
        </ListView>
        <TextBlock x:Name="LayoutStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.Name="Run parameters layout status" />
    </Grid>
</UserControl>
