<UserControl x:Class="GeneSort.WPF.Views.ParameterSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GeneSort.WPF.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <Style x:Key="ParameterInfo" TargetType="StackPanel">
            <Setter Property="Margin" Value="8,6" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Content="{Binding AddLabel}" Click="BeginAdd_Click" Padding="10,5" Margin="8,0,0,0">
                <Button.Style><Style TargetType="Button">
                    <Setter Property="IsEnabled" Value="{Binding HasAvailableParameters}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsAdding}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger></Style.Triggers>
                </Style></Button.Style>
            </Button>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding Help}" Foreground="#536075" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Background="#EDF3FA" BorderBrush="#BACDE3" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsAdding, Converter={StaticResource VisibleIfTrue}}">
            <StackPanel>
                <TextBlock Text="Choose a parameter" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableParameters}" SelectedItem="{Binding SelectedParameter}"
                          DisplayMemberPath="Key" IsEditable="False" AutomationProperties.Name="Parameter to add" />
                <TextBlock Text="{Binding SelectedParameter.Description}" TextWrapping="Wrap" Margin="0,6,0,4" />
                <ContentControl Content="{Binding PendingRow}">
                    <ContentControl.ContentTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding InputHint}" Foreground="#536075" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding InheritedValues}" Foreground="#536075" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Visibility="{Binding HasInheritedValues, Converter={StaticResource VisibleIfTrue}}" />
                            <local:ParameterValuesView />
                        </StackPanel>
                    </DataTemplate></ContentControl.ContentTemplate>
                </ContentControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Click="ConfirmAdd_Click" IsEnabled="{Binding CanAdd}" />
                    <Button Content="Cancel" Click="CancelAdd_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" MaxHeight="360" MinHeight="62"
                  CanUserSortColumns="False" CanUserReorderColumns="False" EnableRowVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E5EC">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Parameter" Width="2*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Style="{StaticResource ParameterInfo}" ToolTip="{Binding Description}">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InputHint}" Foreground="#536075" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InheritedValues}" Foreground="#536075" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasInheritedValues, Converter={StaticResource VisibleIfTrue}}" />
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Values" Width="3*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <local:ParameterValuesView Margin="6,6,2,2" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="84">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="Remove" Click="RemoveRow_Click" Padding="8,4" Margin="4,6" VerticalAlignment="Top"
                                ToolTip="Remove this parameter" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
