<UserControl Style="{StaticResource {x:Type UserControl}}" x:Class="GeneSort.WPF.Views.SetupParameterListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <WrapPanel Grid.Row="1">
            <Button Content="Columns…" Click="ChooseColumns_Click" Margin="0,0,8,8"
                    ToolTip="Choose which columns to show. Changes are saved immediately." />
            <Button Content="Reset layout" Click="ResetLayout_Click" Margin="0,0,0,8"
                    ToolTip="Show all columns and restore the default column order, widths and sorting for Setup parameters." />
            <TextBlock Text="Green: complete | Amber: partial | Brown: not run / not recorded" VerticalAlignment="Center" Margin="12,0,0,8" Foreground="{DynamicResource MutedBrush}" />
        </WrapPanel>
        <ListView x:Name="ParameterItems" Grid.Row="2" ItemsSource="{Binding Items}"
                  AutomationProperties.Name="Shared SetupParameters" SelectionMode="Extended"
                  SelectionChanged="SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Background" Value="#382C25" />
                    <Setter Property="ToolTip" Value="Setup completion is saved after success. Older files may have no completion record." />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SetupStatus}" Value="Complete"><Setter Property="Background" Value="#193D33" /></DataTrigger>
                        <DataTrigger Binding="{Binding SetupStatus}" Value="Partial"><Setter Property="Background" Value="#494019" /></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View><GridView x:Name="ParameterColumns" AllowsColumnReorder="True" /></ListView.View>
        </ListView>
        <TextBlock x:Name="LayoutStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.Name="Setup parameters layout status" />
    </Grid>
</UserControl>

