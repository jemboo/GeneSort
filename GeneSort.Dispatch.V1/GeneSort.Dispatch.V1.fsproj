    <Compile Include="SorterMutate\Msuf4Mutate\Msuf4MutateSpecsRm.fs" />
    <Compile Include="SorterSgd\Utils.fs" />
    <Compile Include="SorterSgd\PoolSetMakers.fs" />
    <Compile Include="SorterSgd\MutatorMakers.fs" />
    <Compile Include="SorterSgd\SortableTestMakers.fs" />
    <Compile Include="SorterSgd\EvolutionOrchestrator.fs" />
    <Compile Include="SorterSgd\SgdExecutor.fs" />
    <Compile Include="SorterSgd\Reporting.fs" />
    <Compile Include="SorterSgd\SorterSgdTypes.fs" />
