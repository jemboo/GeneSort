<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
        <!-- Limit heaps if running multiple processes -->
        <!-- <GCHeapCount>4</GCHeapCount> -->
  </PropertyGroup>
    
  <ItemGroup>
    <Compile Include="BitonicSort.fs" />
    <Compile Include="RunResult.fs" />
    <Compile Include="ProgressMessage.fs" />
    <Compile Include="ParamOps.fs" />
    <Compile Include="RunNaming.fs" />
    <Compile Include="RunHost.fs" />
    <Compile Include="RunType.fs" />
    <Compile Include="SortableTests\Merge.fs" />
    <Compile Include="SortableTests\Prefix.fs" />
    <Compile Include="SortableTests\SortableTestsDbs.fs" />
    <Compile Include="SorterEval\Standard.fs" />
    <Compile Include="SorterEval\Merge.fs" />
    <Compile Include="SorterEval\Prefix.fs" />
    <Compile Include="SorterEval\SorterEvalDbs.fs" />
    <Compile Include="SorterMutate\Standard.fs" />
    <Compile Include="SorterMutate\Merge.fs" />
    <Compile Include="SorterMutate\Prefix.fs" />
    <Compile Include="SorterMutate\SorterMutateDbs.fs" />
    <Compile Include="SorterSgd\p32\OnePool\Common.fs" />
    <Compile Include="SorterSgd\p32\OnePool\Standard.fs" />
    <Compile Include="SorterSgd\p32\OnePool\Soss.fs" />
    <Compile Include="SorterSgd\p32\OnePool\SimpleR.fs" />
    <Compile Include="SorterSgd\p32\OnePool\SimpleS.fs" />
    <Compile Include="SorterSgd\p32\OnePool\Controlled.fs" />
    <Compile Include="SorterSgd\p32\OnePool\Continuation.fs" />
    <Compile Include="SorterSgd\p32\OnePool\SameFamilyChain.fs" />
    <Compile Include="SorterSgd\p32\OnePool\MixedFamilyChain.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\Standard.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\SimpleR.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\SimpleS.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\Standard_append.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\Standard_condense.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\Soss.fs" />
    <Compile Include="SorterSgd\p32\Msuf4a\Soss_condense.fs" />
    <Compile Include="SorterSgd\p24\Msuf63b\Common.fs" />
    <Compile Include="SorterSgd\p24\Msuf63b\MutationRate.fs" />
    <Compile Include="SorterSgd\p32\Msrs4a\Common.fs" />
    <Compile Include="SorterSgd\p32\Msrs4a\MutationRate.fs" />
    <Compile Include="SorterSgd\p24\Msrs3a\Common.fs" />
    <Compile Include="SorterSgd\p24\Msrs3a\OrthoPara.fs" />
    <Compile Include="SorterSgd\p24\Msrs3a\PoolModComp.fs" />
    <Compile Include="SorterSgd\p24\Msrs3b\Common.fs" />
    <Compile Include="SorterSgd\p24\Msrs3b\OrthoPara.fs" />
    <Compile Include="SorterSgd\p24\Mssi3b\Common.fs" />
    <Compile Include="SorterSgd\p24\Mssi3b\OrthoPara.fs" />
    <Compile Include="DispatchLib.fs" />
    <Compile Include="RunTypeCatalog.fs" />
    <Compile Include="WorkflowSources.fs" />
    <Compile Include="RunHostSetupExecutor.fs" />
    <Compile Include="ProjectOps.fs" />
    <Compile Include="ReportOps.fs" />
    <Compile Include="DispatchSortableTests.fs" />
    <Compile Include="DispatchSorterEval.fs" />
    <Compile Include="DispatchSorterMutate.fs" />
    <Compile Include="DispatchSorterSgd.fs" />
    <Compile Include="Sandbox.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
    
  <ItemGroup>
    <None Include="CLOUD_WORKFLOW.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.UMX" Version="1.1.0" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="6.0.0-beta003" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="MessagePack.FSharpExtensions" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeneSort.Core\GeneSort.Core.fsproj" />
    <ProjectReference Include="..\GeneSort.Eval.Mp.V1\GeneSort.Eval.Mp.V1.fsproj" />
    <ProjectReference Include="..\GeneSort.Eval.V1\GeneSort.Eval.V1.fsproj" />
    <ProjectReference Include="..\GeneSort.FileDb.V1\GeneSort.FileDb.V1.fsproj" />
